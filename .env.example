# Copy to .env beside compose.yml (mode 600, never versioned).
#
# The store key, the password and the API token, readable by the app's user (10001) only:
#   install -d -m 0700 secrets
#   just store-key > secrets/store_key      (or: openssl rand -hex 32 > secrets/store_key)
#   printf '%s\n' 'a long admin password' > secrets/password
#   python3 -c "import secrets; print(secrets.token_hex(32))" > secrets/api_token
#   sudo chown 10001:10001 secrets/* && sudo chmod 0400 secrets/*
# Keep a copy of secrets/store_key apart from the backups of the data volume: without it the Cloudflare token and the
# webhook secret set in Settings cannot be read back. Once signed in, change the password in Settings > Security and
# make scoped API keys in Settings > Webhook & API; scripts and other clients send one as `Authorization: Bearer <key>`.
#
# Cloudflare (optional): an API token with Account Rule Lists Write, Account Rulesets Write, Zone Read and DNS Write on
# the account and zones to use, made in Cloudflare (My Profile, API Tokens), set in Settings > Cloudflare. As a fallback
# file instead, uncomment the three cloudflare_token lines of compose.yml:
#   printf '%s\n' 'the Cloudflare token' > secrets/cloudflare_token
#   sudo chown 10001:10001 secrets/cloudflare_token && sudo chmod 0400 secrets/cloudflare_token

# The app image (by version or digest in production)
MOONIE_REDIRECT_IMAGE=moonie-redirect:local
# Required: the address links and QR codes are written with, never the request's host (the app refuses to start
# without it), such as MOONIE_REDIRECT_PUBLIC_BASE_URL=https://go.example.test
MOONIE_REDIRECT_PUBLIC_BASE_URL=
# Traefik's external network
MOONIE_REDIRECT_PROXY_NETWORK=proxy
# Traefik, once the labels of compose.yml are uncommented: the public host of the router's rule, and its entrypoint
# MOONIE_REDIRECT_HOST=go.example.test
# MOONIE_REDIRECT_ENTRYPOINT=websecure
# The container's time zone (links expire by UTC days whatever it is)
# TZ=UTC
# Cloudflare list items allowed per account, while none is set in Settings: 10000 on the free plan
# MOONIE_REDIRECT_CLOUDFLARE_ITEM_LIMIT=10000
